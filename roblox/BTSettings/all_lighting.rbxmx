						<ProtectedString name="Source"><![CDATA[local Sunset = {
	Lighting = {
		Ambient = Color3.fromRGB(113, 98, 0);
		Brightness = 12;
		ColorShift_Bottom = Color3.fromRGB(0, 0, 0);
		ColorShift_Top = Color3.fromRGB(223, 123, 0);
		EnvironmentDiffuseScale = 1;
		EnvironmentSpecularScale = 1;
		OutdoorAmbient = Color3.fromRGB(148, 123, 0);
		ShadowSoftness = 0.15;
		ExposureCompensation = 0.2;
	};

	Bloom = {
		Intensity = 0.4;
		Size = 56;
		Threshold = 1;
	};

	Blur = {
		Size = 2;
	};

	ColorCorrection = {
		Brightness = 0.04;
		Contrast = 0.05;
		Saturation = 0;
		TintColor = Color3.fromRGB(255, 234, 196);
	};

	DepthOfField = {
		FarIntensity = 0.05;
		FocusDistance = 47.36;
		InFocusRadius = 46;
		NearIntensity = 0.21;
	};

	SunRays = {
		Intensity = 0.15;
		Spread = 0.449;
	};

	Atmosphere = {
		Density = 0.349;
		Offset = 0;
		Color = Color3.fromRGB(199, 199, 199);
		Decay = Color3.fromRGB(106, 112, 125);
		Glare = 0;
		Haze = 0;
	};

	Clouds = {
		Cover = 0.603;
		Density = 0.974;
		Color = Color3.fromRGB(200, 165, 140);
	}
}

return Sunset
]]></ProtectedString>

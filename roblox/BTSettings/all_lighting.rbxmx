		OutdoorAmbient = Color3.fromRGB(176, 147, 0);
		ShadowSoftness = 0.15;
		ExposureCompensation = 0.2;
	};

	Bloom = {
		Intensity = 0.4;
		Size = 20;
		Threshold = 1;
	};

	Blur = {
		Size = 2;
	};

	ColorCorrection = {
		Brightness = 0.03;
		Contrast = 0.05;
		Saturation = 0;
		TintColor = Color3.fromRGB(255, 237, 201);
	};

	DepthOfField = {
		FarIntensity = 0.05;
		FocusDistance = 47.36;
		InFocusRadius = 46;
		NearIntensity = 0.21;
	};

	SunRays = {
		Intensity = 0.07;
		Spread = 0.449;
	};

	Atmosphere = {
		Density = 0.32;
		Offset = 0;
		Color = Color3.fromRGB(199, 199, 199);
		Decay = Color3.fromRGB(106, 112, 125);
		Glare = 0;

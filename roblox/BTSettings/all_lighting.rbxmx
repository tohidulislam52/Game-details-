					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Sunrise = {
	Lighting = {
		Ambient = Color3.fromRGB(89, 65, 140);
		Brightness = 12;
		ColorShift_Bottom = Color3.fromRGB(0, 0, 0);
		ColorShift_Top = Color3.fromRGB(223, 149, 0);
		EnvironmentDiffuseScale = 1;
		EnvironmentSpecularScale = 1;
		OutdoorAmbient = Color3.fromRGB(144, 101, 148);
		ShadowSoftness = 0.15;
		ExposureCompensation = 0.2;
	};

	Bloom = {
		Intensity = 0.1;
		Size = 56;
		Threshold = 1;
	};

	Blur = {
		Size = 2;
	};

	ColorCorrection = {
		Brightness = 0.04;
		Contrast = 0.05;
		Saturation = 0;
		TintColor = Color3.fromRGB(255, 241, 216);
	};

	DepthOfField = {
		FarIntensity = 0.05;
		FocusDistance = 47.36;
		InFocusRadius = 46;
		NearIntensity = 0.21;
	};

	SunRays = {
		Intensity = 0.15;
		Spread = 0.449;
	};

	Atmosphere = {
		Density = 0.35;
		Offset = 0;
		Color = Color3.fromRGB(199, 199, 199);
		Decay = Color3.fromRGB(106, 112, 125);
		Glare = 0;
		Haze = 0;
	};

	Clouds = {
		Cover = 0.603;
		Density = 0.974;
		Color = Color3.fromRGB(135, 111, 94);
	}
	
	--Clock time = {
	--	Clock time= 6.5;
	--	g = 31;
	--	Color = Color3.fromRGB(135, 111, 94);
	--}
}

return Sunrise
]]></ProtectedString>

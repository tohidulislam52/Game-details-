						<ProtectedString name="Source"><![CDATA[local AfternoonGoldenHour = {
	Lighting = {
		Ambient = Color3.fromRGB(113, 96, 0);
		Brightness = 4;
		ColorShift_Bottom = Color3.fromRGB(0,0,0);
		ColorShift_Top = Color3.fromRGB(223, 175, 0);
